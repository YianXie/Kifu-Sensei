{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true,
        "paths": {
            "@/*": ["./src/*"],
            "@shared/*": ["../shared/src/*"]
        }
    },
    /* ../shared is compiled from source rather than consumed as a built package,
       so it has to be part of this project for `tsc -b` to check it. */
    "include": ["src", "../shared/src"],
    /* Shared *sources* only. Its tests import vitest, which resolves from
       shared/node_modules — a directory this project never installs, so including
       them makes this build depend on someone having run `npm install` in a
       sibling. They are type-checked by shared's own tsc, where they belong. */
    "exclude": ["../shared/src/**/*.test.ts"]
}
