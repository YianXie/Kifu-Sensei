# Copy this file to .env and fill in the values.
# Development defaults are used when ENVIRONMENT=development.

ENVIRONMENT=development

# Required in production; a random insecure key is used in development.
SECRET_KEY=your-secret-key-here

# Required in production — the public hostname of the backend.
# ALLOWED_HOST=api.yourdomain.com

# Required in production — the public URL of the frontend.
# FRONTEND_URL=https://yourdomain.com
