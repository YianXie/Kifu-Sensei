# Copy this file to .env and fill in the values.
# Development defaults are used when ENVIRONMENT=development.

ENVIRONMENT=development

# Required in production — key used to sign access/refresh JWTs (HS256).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-here

# Off by default — the /admin SQLAdmin dashboard is not mounted at all unless this
# is set to true. Turn it on deliberately; it grants read access to every user's
# email and full CRUD over commentary rows behind a single shared password.
# ENABLE_ADMIN=true

# Required in production if ENABLE_ADMIN is set — credentials for the /admin
# SQLAdmin interface.
# ADMIN_USERNAME=your-admin-username
# ADMIN_PASSWORD=your-admin-password

# Required in production — used to encrypt secrets (e.g. users' Claude API keys)
# at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-here

# SQLModel/SQLAlchemy database URL. Defaults to a local SQLite file.
DATABASE_URL=sqlite:///./db.sqlite3

# Required in production — the public URL of the frontend (added to CORS origins).
# localhost:5173/127.0.0.1:5173 are allowed automatically outside production; in
# production only FRONTEND_URL is allowed, so it must be set for the real frontend to
# be able to call the API at all.
FRONTEND_URL=https://yourdomain.com

# Required — base URL of the KataGo analysis engine.
API_ENDPOINT=http://localhost:8001

# Optional — request timeout (seconds) for the KataGo analysis engine.
# API_TIMEOUT=120

# Optional — visit budget for a single /analyze request. A pass is sent in batches of
# turns costing at most this many KataGo visits, so that no one request outlasts the
# window a proxy in front of the engine is willing to wait for. Default: 1000, i.e. 20
# turns of the fast pass or 2 of the detailed one. Lower it for a slower engine.
# KATAGO_VISITS_PER_REQUEST=1000

# Optional — how many commentary pipelines (KataGo + Anthropic calls) run at once,
# on a dedicated executor separate from the request threadpool. Default: 4.
# COMMENTARY_PIPELINE_WORKERS=4

# Optional — requests with a larger Content-Length than this (bytes) are rejected
# before the body is read. Default: 5000000 (5 MB).
# MAX_REQUEST_BODY_BYTES=5000000
