# Copy this file to .env and fill in the values.
# Development defaults are used when ENVIRONMENT=development.

ENVIRONMENT=development

# Required in production — key used to sign access/refresh JWTs (HS256).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-here

# Required in production — credentials for the /admin SQLAdmin interface.
# ADMIN_USERNAME=your-admin-username
# ADMIN_PASSWORD=your-admin-password

# Required in production — used to encrypt secrets (e.g. users' Claude API keys)
# at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-here

# SQLModel/SQLAlchemy database URL. Defaults to a local SQLite file.
DATABASE_URL=sqlite:///./db.sqlite3

# Required in production — the public URL of the frontend (added to CORS origins).
FRONTEND_URL=https://yourdomain.com

# Required — base URL of the KataGo analysis engine.
API_ENDPOINT=http://localhost:8001

# Optional — request timeout (seconds) for the KataGo analysis engine.
# API_TIMEOUT=120
