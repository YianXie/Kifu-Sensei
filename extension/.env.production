# Loaded by `npm run build` (Vite mode: production). No secrets here — these
# are public origins that get inlined into the bundled extension.

# The URL to the backend API
VITE_API_URL=https://api.kifu-sensei.ai

# The URL to the Kifu-Sensei frontend. www is the canonical origin — the bare
# apex 301s there and the API only allows CORS from www.
VITE_FRONTEND_URL=https://www.kifu-sensei.ai
