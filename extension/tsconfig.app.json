{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "target": "es2023",
        "module": "esnext",
        "lib": ["ES2023", "DOM"],
        "types": ["vite/client", "chrome-types"],
        "skipLibCheck": true,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,

        /* Type safety — matches frontend/tsconfig.app.json. Without this the
           panel, the job state machine and the auth plumbing all compile with
           strictNullChecks off, which is exactly where the two front ends share
           code and drift. */
        "strict": true,

        /* Linting */
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true,

        "paths": {
            "@shared/*": ["../shared/src/*"]
        }
    },
    /* ../shared is compiled from source rather than consumed as a built package,
       so it has to be part of this project for `tsc -b` to check it — and this is
       where `erasableSyntaxOnly` gets applied to it, which shared's own tsconfig
       cannot do while it is pinned to the frontend's older TypeScript. */
    "include": ["src", "panel", "../shared/src"],
    /* Shared *sources* only. Its tests import vitest, which resolves from
       shared/node_modules — a directory this project never installs, so including
       them makes this build depend on someone having run `npm install` in a
       sibling. They are type-checked by shared's own tsc, where they belong. */
    "exclude": ["../shared/src/**/*.test.ts"]
}
