# Loaded by `npm run dev` and `npm run build:dev` (Vite mode: development).
# Values here override .env — keep local-only overrides in .env.local instead.

# The URL to the backend API
VITE_API_URL=http://localhost:8000

# The URL to the Kifu-Sensei frontend. Used by the side panel to open the
# login/register tabs during the auth handoff.
VITE_FRONTEND_URL=http://localhost:5173
