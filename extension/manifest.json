{
    "manifest_version": 3,
    "name": "Kifu-Sensei",
    "version": "0.1.0",
    "description": "An automated LLM-based Go game commentary generator",

    "permissions": ["storage", "sidePanel", "activeTab"],

    "host_permissions": ["https://online-go.com/*", "https://kifu-sensei.ai/*"],

    "background": {
        "service_worker": "dist/background/service-worker.js",
        "type": "module"
    },

    "content_scripts": [
        {
            "matches": ["https://online-go.com/game/*"],
            "js": ["dist/content/index.js"],
            "css": ["dist/styles/overlay.css"],
            "run_at": "document_idle"
        }
    ],

    "side_panel": {
        "default_path": "popup/panel.html"
    },

    "action": {
        "default_title": "Kifu-Sensei",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },

    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
