{
    "manifest_version": 3,
    "name": "Kifu-Sensei",
    "version": "0.1.0",
    "description": "An automated LLM-based Go game commentary generator",
    "permissions": [
        "storage",
        "sidePanel",
        "activeTab",
        "tabs",
        "scripting",
        "alarms"
    ],
    "host_permissions": [
        "http://localhost:5173/*",
        "http://localhost:8000/*",
        "https://online-go.com/*",
        "https://*.kifu-sensei.ai/*"
    ],
    "background": {
        "service_worker": "dist/background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "http://localhost:5173/*",
                "https://*.kifu-sensei.ai/*",
                "https://online-go.com/*"
            ],
            "js": ["dist/content.js"],
            "run_at": "document_idle"
        }
    ],
    "side_panel": {
        "default_path": "dist/panel/panel.html"
    },
    "web_accessible_resources": [
        {
            "matches": [
                "http://localhost:5173/*",
                "https://*.kifu-sensei.ai/*",
                "https://online-go.com/*"
            ],
            "resources": ["dist/inject.js", "dist/icons/*"]
        }
    ],
    "action": {
        "default_title": "Kifu-Sensei: click to open side panel",
        "default_icon": {
            "16": "dist/icons/icon-16.png",
            "32": "dist/icons/icon-32.png",
            "48": "dist/icons/icon-48.png",
            "128": "dist/icons/icon-128.png"
        }
    },
    "icons": {
        "16": "dist/icons/icon-16.png",
        "32": "dist/icons/icon-32.png",
        "48": "dist/icons/icon-48.png",
        "128": "dist/icons/icon-128.png"
    }
}
