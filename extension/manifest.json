{
    "manifest_version": 3,
    "name": "Kifu-Sensei",
    "version": "0.1.0",
    "description": "An automated LLM-based Go game commentary generator",

    "permissions": ["storage", "sidePanel", "activeTab", "tabs", "scripting"],

    "host_permissions": ["https://online-go.com/*", "https://kifu-sensei.ai/*"],

    "background": {
        "service_worker": "dist/background/service-worker.js",
        "type": "module"
    },

    "content_scripts": [
        {
            "matches": ["https://online-go.com/game/*"],
            "js": ["dist/content/index.js"],
            "css": ["dist/styles/overlay.css"],
            "run_at": "document_idle",
            "type": "module"
        }
    ],

    "side_panel": {
        "default_path": "dist/panel/panel.html"
    },

    "web_accessible_resources": [
        {
            "resources": ["dist/chunks/*"],
            "matches": ["https://online-go.com/*"]
        }
    ],

    "action": {
        "default_title": "Kifu-Sensei",
        "default_popup": "dist/popup/popup.html",
        "default_icon": {
            "16": "dist/icons/icon-16.png",
            "32": "dist/icons/icon-32.png",
            "48": "dist/icons/icon-48.png",
            "128": "dist/icons/icon-128.png"
        }
    },

    "icons": {
        "16": "dist/icons/icon-16.png",
        "32": "dist/icons/icon-32.png",
        "48": "dist/icons/icon-48.png",
        "128": "dist/icons/icon-128.png"
    }
}
